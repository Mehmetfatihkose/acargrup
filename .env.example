# ==========================================================
# ACAR GRUP KURUMSAL PORTFÖY — ORTAM DEĞİŞKENLERİ ÖRNEĞİ
# Kullanım: Bu dosyayı .env olarak kopyalayın (cp .env.example .env)
# ==========================================================

# Backend Sunucu Ayarları
PORT=4000
NODE_ENV=development
DATABASE_PATH=./data/acargrup.sqlite

# CORS İzin Verilen Frontend Adresi
CORS_ORIGIN=http://localhost:5173

# Görsel Yükleme Ayarları
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
MAX_IMAGE_SIZE_MB=5
IMAGE_MAX_WIDTH=1920

# İlk Admin Kullanıcısı (yalnızca veritabanında hiç admin yokken, ilk açılışta kullanılır)
# ADMIN_PASSWORD boş bırakılırsa rastgele şifre üretilip sunucu konsoluna yazılır.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Opsiyonel E-Posta Bildirim Ayarları (Nodemailer)
# Boş bırakılırsa form kayıtları veritabanına yazılır ve konsola loglanır.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Acar Grup Kurumsal <kurumsal@acargrup.com.tr>"
MAIL_TO="iletisim@acargrup.com.tr"

# Frontend API Adresi (Vite için client/.env içinde veya proxy ile kullanılır)
VITE_API_BASE_URL=/api
VITE_SITE_URL=https://www.acargrup.com.tr

