{
  "name": "acar-grup-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.json && node --watch dist/index.js",
    "watch:ts": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "seed": "tsc -p tsconfig.json && node dist/seed/seed.js",
